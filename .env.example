# Vercel web and private Botkeep services share the application database and encryption key.
DATABASE_URL=postgresql://server_role:replace-me@db-host:5432/machinarc
DATABASE_SSL_CA=
MARC_ENCRYPTION_KEY=replace-with-a-private-random-value-of-at-least-32-characters
MARC_REQUIRE_ENCRYPTION_KEY=on
MARC_WORKER=off
MACHINARC_EXECUTION_MODE=botkeep
CRON_SECRET=

# Botkeep Node.js 22 services. Use the port allocated in Network (SERVER_PORT).
NODE_ENV=production
TZ=UTC
HOST=0.0.0.0
SERVER_PORT=3101
MACHINARC_WORKER_CONCURRENCY=2
MACHINARC_POLL_INTERVAL_MS=3000
MACHINARC_SCHEDULER_POLL_INTERVAL_MS=10000
MACHINARC_JOB_LEASE_SECONDS=120
MACHINARC_SHUTDOWN_TIMEOUT_MS=30000

# Tests only; must identify a disposable database distinct from DATABASE_URL.
TEST_DATABASE_URL=
